[Unit]
# nvme-cli legt Host-NQN und Host-ID für NVMe-oF bei der Installation an. Aus dem ISO wären sie für
# alle Starts dieselben und stünden im öffentlichen Image (#148), chroot-setup.sh entfernt sie darum.
# Jeder Start bekommt eigene, so wie nvme-cli sie bei der Installation anlegt: bevor udev die Geräte
# meldet und bevor sich etwas mit NVMe-oF verbindet.
Description=Leuchtfeuer: NVMe-Host-NQN und Host-ID für diesen Start
DefaultDependencies=no
Before=systemd-udev-trigger.service nvmefc-boot-connections.service nvmf-autoconnect.service nvmf-connect-nbft.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'umask 022 && mkdir -p /etc/nvme && { [ -s /etc/nvme/hostnqn ] || /usr/sbin/nvme gen-hostnqn >/etc/nvme/hostnqn; } && { [ -s /etc/nvme/hostid ] || /usr/bin/uuidgen >/etc/nvme/hostid; }'

[Install]
WantedBy=sysinit.target
